# API service (api/) — NestJS 10 backend for the web dashboard

# MongoDB connection string
MONGO_URI=mongodb://mongodb-svc:27017/accbot

# Telegram user ID — all API queries are scoped to this user
BOSS_USER_ID=

# Mistral API key — used for the Tips and Compare AI features
MISTRAL_API_KEY=

# Authentik OIDC issuer URL, used to validate JWTs
AUTHENTIK_ISSUER=http://10.0.0.98:9000/application/o/bot-angular-auth/

# Authentik JWKS endpoint, used to validate JWTs
AUTHENTIK_JWKS_URI=http://10.0.0.98:9000/application/o/bot-angular-auth/jwks/

# Allowed CORS origin for the web app
CORS_ORIGIN=https://bot.andujaronline.uk

# API port
PORT=4000

# ---------------------------------------------------------------------------
# Email ingestion
#
# Reads bank alert emails over IMAP (read-only) and turns them into
# transactions. If GMAIL_USER/GMAIL_APP_PASSWORD are missing, the IMAP
# client fails soft: it logs a warning and returns no mail rather than
# throwing, so ingestion silently never runs instead of crashing the API.
# See README.md "Environment Variables (API)" for full setup notes.
# ---------------------------------------------------------------------------

# Gmail address to read from
GMAIL_USER=

# Google App Password (Google Account > Security > 2-Step Verification >
# App passwords) — NOT your normal account password.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Mailbox or label to read (default: INBOX). Recommended: point this at a
# dedicated label instead of the whole mailbox. This account uses "Banks".
INGEST_MAILBOX=Banks

# Poll schedule, cron expression (default: every 10 minutes)
INGEST_POLL_CRON=*/10 * * * *

# Forward-only watermark (ISO date) — mail received before this is never
# ingested. Defaults to 24 hours ago if unset. Set this to roughly when you
# switch ingestion on, to avoid double-counting historical mail.
# INGEST_START_AT=2026-09-23T00:00:00Z

# Comma-separated own-account identifiers (last-4 digits and/or a name
# fragment), used to tell whether a Banreservas transfer is income or
# expense. If unset, Banreservas transfers are skipped entirely rather
# than guessed.
OWN_ACCOUNT_IDENTIFIERS=

# Comma-separated last-4 digits of your own savings/checking accounts. A
# transfer whose DESTINATION matches one of these is an internal move between
# your own accounts: recorded and visible, but never counted as an expense and
# never applied to your balance.
#
# Deliberately separate from OWN_ACCOUNT_IDENTIFIERS, which also holds name
# fragments. A loan account carries your own name, so a name match must never
# imply "internal" — that would erase a real monthly expense.
#
# If empty, no transfer is ever classified internal: transfers are treated as
# expenses, which over-reports visibly rather than losing money silently.
OWN_CASH_ACCOUNTS=

# Fallback USD->DOP rate used when the live FX lookup fails (default: 60)
USD_DOP_RATE=60
