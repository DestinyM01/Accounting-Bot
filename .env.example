# Telegram bot token from @BotFather
TELEGRAM_TOKEN=

# Anthropic API key (replaces OpenAI)
ANTHROPIC_API_KEY=

# MongoDB — Docker Compose (set MONGO_URI to skip MONGODB_URL/NAME)
MONGO_URI=mongodb://mongo:27017/accbot

# MongoDB — external Atlas or self-hosted (used only when MONGO_URI is not set)
# MONGODB_URL=mongodb+srv://...
# MONGODB_NAME=accbot

# Optional: cron schedule and timezone for daily notifications
CRON_SCHEDULE=47 15 * * *
CRON_TIMEZONE=Europe/Kiev

# App port (not exposed by default - only accessed internally)
PORT=3000
